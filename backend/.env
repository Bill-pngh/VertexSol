# ======================
# Core Server Configuration
# ======================
NODE_ENV=production
PORT=3000
SERVER_URL=https://your-render-url.onrender.com
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ======================
# Database (PostgreSQL)
# ======================
PG_HOST=your-postgres-host.onrender.com
PG_PORT=5432
PG_DATABASE=vertexsol_prod
PG_USER=vertexsol_admin
PG_PASSWORD=strong_password_with_symbols_123!@#
PG_SSL=true

# ======================
# Encryption & Security
# ======================
# Generate via: openssl rand -hex 32
ENCRYPTION_KEY=5f4dcc3b5aa765d61d8327deb882cf99baca7963d6a5d3e3f4d5721f4d5e6f7a
JWT_SECRET=another_secure_key_987%^&
COOKIE_SECRET=third_secure_key_456*() 

# ======================
# Solana Configuration
# ======================
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
TRANSACTION_TIMEOUT=30000 # 30 seconds

# ======================
# Rate Limiting
# ======================
RATE_LIMIT_WINDOW=15 # minutes
RATE_LIMIT_MAX=100 # requests per window
WALLET_RATE_LIMIT=5 # attempts per 15min

# ======================
# Telegram WebApp
# ======================
TELEGRAM_WEBAPP_URL=https://your-telegram-webapp-url.com
TELEGRAM_API_HASH=your_telegram_api_hash
